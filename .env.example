# Variáveis de ambiente do projeto.
# Copie este arquivo para .env.local e preencha com os valores reais
# (Dashboard Supabase → Settings → API Keys).

# Supabase — URL do projeto
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — chave pública (publishable), exposta ao browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — chave secreta, uso exclusivo server-side (bypassa RLS, nunca expor ao browser)
SUPABASE_SECRET_KEY=

# Segredo do cron de lembretes de aula (Fase 13) — o Vercel Cron envia esse
# valor automaticamente como "Authorization: Bearer <valor>" quando a env
# var CRON_SECRET está configurada no projeto Vercel; a Route Handler
# rejeita qualquer chamada sem esse header batendo.
CRON_SECRET=

# Bot do Telegram (Fase 14) — @genezi_educacao_bot. Usado pelo motor de
# automações (src/lib/telegram/client.ts) pra notificar o grupo de eventos
# do sistema (pagamento recebido, matrícula criada, resumo diário, etc.).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
